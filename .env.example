# Supabase（ローカルは `npm run db:start` の出力にある API URL と publishable / anon key）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# アプリの公開 URL（ログイン後の戻り先に使う）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ログイン方法の表示切り替え（"1" で表示）
NEXT_PUBLIC_ENABLE_GOOGLE=0
# Apple Developer Program 登録後に 1 にする
NEXT_PUBLIC_ENABLE_APPLE=0
# 開発用ログイン（匿名ログイン）。本番では必ず 0
NEXT_PUBLIC_DEV_LOGIN=1

# Supabase 休止対策の定期アクセス用（Vercel Cron が自動で付ける）
CRON_SECRET=
